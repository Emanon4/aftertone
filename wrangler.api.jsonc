{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aftertone-api",
  "main": "worker/main.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aftertone-api",
    "database_id": "3a81b1bb-d4b1-4d90-ab33-4ee6e918f453",
    "migrations_dir": "worker/migrations"
  }],
  // One SQLite-backed Durable Object per job drives its steps with alarms.
  "durable_objects": {
    "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
  },
  "migrations": [{ "tag": "v1-job-runner", "new_sqlite_classes": ["JobRunner"] }],
  // Per-IP limit on search/lookups that reach Deezer or iTunes (cache hits are not counted).
  "ratelimits": [{ "name": "MUSIC_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }],
  // Optional: move the catalog to R2 (see docs/deploy.md), then uncomment.
  // "r2_buckets": [{ "binding": "CATALOG", "bucket_name": "aftertone-catalog" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://emanon4.github.io",
    "CANDIDATE_LIMIT": "600",
    "SITE_DAILY_ROUNDS": "100",
    "PERSONAL_DAILY_ROUNDS": "30",
    "IP_DAILY_ROUNDS": "20",
    "PERSONAL_GLOBAL_DAILY_ROUNDS": "300",
    "ITUNES_COUNTRY": "SG"
  },
  // TURNSTILE_SITE_KEY can be a var; TURNSTILE_SECRET_KEY and IP_HASH_SALT must be secrets.
  "secrets": { "required": ["TYPESAFE_API_KEY"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
