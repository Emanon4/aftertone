# Worker secrets for local development go in .dev.vars (ignored by Git), not here.
# TYPESAFE_API_KEY=        site Jev key (required for site recommendations)
# IP_HASH_SALT=            random string for per-visitor daily hashes
# TURNSTILE_SECRET_KEY=    optional human check (set TURNSTILE_SITE_KEY in wrangler vars too)

# Front-end build variables
# VITE_API_BASE=https://aftertone-api.<account>.workers.dev
# PAGES_BASE_PATH=/aftertone/
