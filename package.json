{
  "name": "aftertone",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "build": "vite build --config vite.pages.config.ts",
    "start": "vite preview --config vite.pages.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:api": "wrangler dev --config wrangler.api.jsonc --port 8788",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "check:api": "wrangler deploy --dry-run --config wrangler.api.jsonc",
    "types:worker": "wrangler types worker/env.d.ts --config wrangler.api.jsonc --env-interface AftertoneApiEnv --include-runtime false --strict-vars=false",
    "catalog:upload": "node scripts/upload-catalog.mjs",
    "catalog:compact": "node scripts/compact-catalog.mjs",
    "catalog:enrich": "node scripts/enrich-albums.mjs",
    "compare:prerank": "node scripts/compare-prerank.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emanon4/aftertone.git"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
